# ==============================================================================
# SkyOne International Courier Service - Environment Configuration Template
# Copy this file to .env and configure your environment-specific values.
# NEVER commit real production secrets or credentials to source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Public Canonical Site URL
PUBLIC_SITE_URL=http://localhost:3000

# Tracking API Configuration (Live Carrier Integration)
# Speedex / SPD Express Tracking Provider:
CARRIER_API_URL=http://admin.spdexp.com/api/tracking_api/get_tracking_data
CARRIER_COMPANY_ID=24
CARRIER_CUSTOMER_CODE=

# Generic External Carrier Tracking Proxy (optional alternative)
TRACKING_API_URL=
TRACKING_API_KEY=
TRACKING_DEMO_MODE=true

# Notification / Lead Dispatch Service (Quote & Contact submissions)
# Supported types: log, smtp, webhook
LEAD_NOTIFIER_TYPE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=skyonesupport@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=skyonesupport@gmail.com
DISPATCH_EMAIL_NOTIFICATION=skyonesupport@gmail.com

# Google Sheet / Excel Webhook URL (For automatic spreadsheet entry)
GOOGLE_SHEET_URL=
LEAD_WEBHOOK_URL=

# CORS Allowed Origins (comma-separated list for production API security)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://skyonecourier.com

