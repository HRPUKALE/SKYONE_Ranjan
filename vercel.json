{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/track"
    },
    {
      "source": "/api/quote",
      "destination": "/api/quote"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
